# Token do bot (fale com o @BotFather no Telegram)
TOKEN_TELEGRAM_BOT=

# Provedor de imagens: openai | cloudflare | pollinations
IMAGE_PROVIDER=openai

# --- OpenAI (pago) — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium

# --- Cloudflare Workers AI (grátis até 10.000 neurons/dia) — https://dash.cloudflare.com ---
CLOUDFLARE_ACCOUNT_ID=
# Token com permissão "Workers AI"
CLOUDFLARE_API_TOKEN=
# Passos de difusão do FLUX.1 schnell (1 a 8)
CLOUDFLARE_STEPS=4

# --- Pollinations (funciona sem chave, com limite de 1 imagem a cada 45s) — https://enter.pollinations.ai ---
POLLINATIONS_API_KEY=

# --- Opcionais (valem para qualquer provedor) ---
# Modelo; vazio usa o padrão do provedor:
#   openai: gpt-image-2.5-flare | cloudflare: @cf/black-forest-labs/flux-1-schnell | pollinations: black-forest-labs/flux.1-schnell
IMAGE_MODEL=
# LARGURAxALTURA (ignorado pelo flux-1-schnell da Cloudflare)
IMAGE_SIZE=1024x1024
# Imagens por mensagem (1 a 10)
IMAGE_COUNT=4
COOLDOWN_SECONDS=60
MAX_PROMPT_LENGTH=1000
# IDs do Telegram autorizados, separados por vírgula (vazio = qualquer pessoa)
ALLOWED_USER_IDS=
